#!/usr/bin/env zsh

# =============================================================================
# ensure_venv_manager
# =============================================================================
# A zsh-compatible helper/manager script for the mrtamaki command-line toolkit.
# Manages Python virtual environments, dependency installation, and provides
# interactive cleanup prompts after running proxy_converter.
## Designed for macOS with zsh shell.
# =============================================================================

# -----------------------------------------------------------------------------
# CONFIGURATION VARIABLES
# -----------------------------------------------------------------------------
# Override these via environment variables before sourcing, or edit defaults.

# MRTAMAKI_ROOT: Root directory of the mrtamaki project.
# Defaults to the directory containing this script, or current directory if sourced.
# Override with: export MRTAMAKI_ROOT="/path/to/mrtamaki"
if [[ -z "${MRTAMAKI_ROOT}" ]]; then
    if [[ -n "${0:A:h}" && "${0:A:h}" != "." ]]; then
        MRTAMAKI_ROOT="${0:A:h}"
    else
        MRTAMAKI_ROOT="${PWD}"
    fi
fi

# VENV_DIR: Directory for the Python virtual environment.
# Defaults to .venv inside MRTAMAKI_ROOT.
: "${VENV_DIR:=${MRTAMAKI_ROOT}/.venv}"

# REQUIREMENTS_FILE: Path to requirements.txt for dependency installation.
: "${REQUIREMENTS_FILE:=${MRTAMAKI_ROOT}/requirements.txt}"

# PYTHON_CMD: Python interpreter command for creating venvs and running tools.
: "${PYTHON_CMD:=python3}"

# MRTAMAKI_CMD: How to invoke the mrtamaki CLI from within the venv.
# Options:
#   - "${VENV_DIR}/bin/mrtamaki" (if installed as entry point)
#   - "${VENV_DIR}/bin/python -m mrtamaki" (module invocation)
: "${MRTAMAKI_CMD:=${VENV_DIR}/bin/python -m mrtamaki}"

# PROXY_CONVERTER_CMD: How to invoke proxy_converter from within the venv.
# Options:
#   - "${VENV_DIR}/bin/python ${MRTAMAKI_ROOT}/proxy_converter.py" (script invocation)
#   - "${VENV_DIR}/bin/python -m mrtamaki.proxy_converter" (module invocation)
: "${PROXY_CONVERTER_CMD:=${VENV_DIR}/bin/python ${MRTAMAKI_ROOT}/proxy_converter.py}"

# FOUND_DIR: Directory for the 'found' project.
: "${FOUND_DIR:=${MRTAMAKI_ROOT}/found}"

# FOUND_REQUIREMENTS_FILE: Path to requirements.txt for 'found' project dependencies.
: "${FOUND_REQUIREMENTS_FILE:=${MRTAMAKI_ROOT}/Files/requirements.txt}"

# -----------------------------------------------------------------------------
# HELPER FUNCTIONS
# -----------------------------------------------------------------------------

# _evm_log: Print a formatted log message to stderr.
# Usage: _evm_log "message"
_evm_log() {
    print -P "%F{cyan}[ensure_venv_manager]%f $1" >&2
}

# _evm_error: Print a formatted error message to stderr.
# Usage: _evm_error "error message"
_evm_error() {
    print -P "%F{red}[ensure_venv_manager ERROR]%f $1" >&2
}

# _evm_success: Print a formatted success message to stderr.
# Usage: _evm_success "success message"
_evm_success() {
    print -P "%F{green}[ensure_venv_manager]%f $1" >&2
}

# ask_yes_no: Prompt user with a yes/no question.
# Returns 0 for yes, 1 for no.
# Usage: ask_yes_no "Your question here?"
ask_yes_no() {
    local question="$1"
    local response

    # Use zsh's read with prompt
    print -n "$question " >&2
    read -r response

    # Accept y, Y, yes, Yes, YES, etc. as affirmative
    case "$response" in
        [yY]|[yY][eE][sS])
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# _safe_path_check: Verify a path is safe for deletion operations.
# Returns 0 if path is safe, 1 if dangerous.
# Usage: _safe_path_check "/some/path"
_safe_path_check() {
    local path="$1"

    # Reject empty paths
    if [[ -z "$path" ]]; then
        _evm_error "Path is empty - refusing to proceed."
        return 1
    fi

    # Resolve to absolute path
    local resolved_path="${path:A}"

    # Reject root directory
    if [[ "$resolved_path" == "/" ]]; then
        _evm_error "Path resolves to root (/) - refusing to proceed."
        return 1
    fi

    # Reject home directory itself
    if [[ "$resolved_path" == "$HOME" ]]; then
        _evm_error "Path resolves to HOME ($HOME) - refusing to proceed."
        return 1
    fi

    # Reject paths with only 1-2 components (too close to root)
    # Use pure zsh: split by '/' and count non-empty elements
    local -a path_parts
    path_parts=("${(@s:/:)resolved_path}")
    # Filter out empty elements (from leading/trailing slashes)
    path_parts=(${path_parts:#})
    local component_count=${#path_parts}
    if [[ "$component_count" -lt 3 ]]; then
        _evm_error "Path too close to filesystem root - refusing to proceed."
        return 1
    fi

    return 0
}

# -----------------------------------------------------------------------------
# VIRTUAL ENVIRONMENT MANAGEMENT FUNCTIONS
# -----------------------------------------------------------------------------

# is_venv_valid: Check if a directory is a valid Python virtual environment.
# Returns 0 if valid, 1 otherwise.
# Usage: is_venv_valid "/path/to/venv"
is_venv_valid() {
    local venv_path="$1"

    # Check directory exists
    [[ -d "$venv_path" ]] || return 1

    # Check for key venv components (macOS/Unix structure)
    [[ -f "$venv_path/bin/activate" ]] || return 1
    [[ -f "$venv_path/bin/python" ]] || return 1
    [[ -f "$venv_path/pyvenv.cfg" ]] || return 1

    return 0
}

# activate_venv: Safely activate the virtual environment in the current shell.
# Exits with error if activation fails.
# Usage: activate_venv
activate_venv() {
    local activate_script="${VENV_DIR}/bin/activate"

    if [[ ! -f "$activate_script" ]]; then
        _evm_error "Cannot find activation script at: $activate_script"
        _evm_error "The virtual environment may be corrupted or missing."
        return 1
    fi

    # Source the activation script
    # shellcheck disable=SC1090
    source "$activate_script"

    if [[ $? -ne 0 ]]; then
        _evm_error "Failed to activate virtual environment."
        return 1
    fi

    _evm_log "Activated venv at: ${VENV_DIR}"
    return 0
}

# deactivate_venv_if_active: Deactivate the venv if currently active.
# Safe to call even if no venv is active.
# Usage: deactivate_venv_if_active
deactivate_venv_if_active() {
    # Check if deactivate function exists (set by venv activation)
    if typeset -f deactivate > /dev/null 2>&1; then
        deactivate
        _evm_log "Deactivated virtual environment."
    fi
}

# install_or_update_deps: Upgrade pip and install/update dependencies.
# Assumes venv is already activated or uses venv's pip directly.
# Idempotent: safe to run multiple times.
# Usage: install_or_update_deps
install_or_update_deps() {
    local pip_cmd="${VENV_DIR}/bin/pip"
    local python_cmd="${VENV_DIR}/bin/python"

    if [[ ! -x "$pip_cmd" ]]; then
        _evm_error "pip not found in venv at: $pip_cmd"
        return 1
    fi

    _evm_log "Upgrading pip..."
    "$python_cmd" -m pip install --upgrade pip --quiet
    if [[ $? -ne 0 ]]; then
        _evm_error "Failed to upgrade pip."
        return 1
    fi

    # Install dependencies from requirements.txt if it exists
    if [[ -f "$REQUIREMENTS_FILE" ]]; then
        _evm_log "Installing dependencies from: $REQUIREMENTS_FILE"
        "$pip_cmd" install -r "$REQUIREMENTS_FILE" --quiet
        if [[ $? -ne 0 ]]; then
            _evm_error "Failed to install dependencies from $REQUIREMENTS_FILE"
            return 1
        fi
        _evm_success "Dependencies installed/updated successfully."
    else
        _evm_log "No requirements.txt found at $REQUIREMENTS_FILE - skipping dependency installation."
    fi

    return 0
}

# ensure_venv_exists: Ensure the virtual environment exists and is properly set up.
# Creates the venv if missing or invalid, upgrades pip, and installs dependencies.
# Idempotent: safe to call before every tool run.
# Usage: ensure_venv_exists
ensure_venv_exists() {
    _evm_log "Checking virtual environment at: ${VENV_DIR}"

    # Pre-flight check: verify requirements file exists
    if [[ ! -f "$REQUIREMENTS_FILE" ]]; then
        _evm_error "Requirements file not found: $REQUIREMENTS_FILE"
        return 1
    fi

    # Check if venv already exists and is valid
    if is_venv_valid "${VENV_DIR}"; then
        _evm_log "Virtual environment exists and appears valid."
        # Sync dependencies in case requirements.txt changed
        install_or_update_deps
        return 0
    fi

    _evm_log "Virtual environment missing or invalid. Creating new venv..."

    # Verify Python command is available
    if ! command -v "${PYTHON_CMD}" > /dev/null 2>&1; then
        _evm_error "Python command not found: ${PYTHON_CMD}"
        _evm_error "Please install Python 3 or set PYTHON_CMD to the correct path."
        return 1
    fi

    # Create the virtual environment
    "${PYTHON_CMD}" -m venv "${VENV_DIR}"
    if [[ $? -ne 0 ]]; then
        _evm_error "Failed to create virtual environment at: ${VENV_DIR}"
        return 1
    fi

    _evm_success "Created virtual environment at: ${VENV_DIR}"

    # Upgrade pip and install dependencies
    install_or_update_deps
    if [[ $? -ne 0 ]]; then
        _evm_error "Failed to set up dependencies in new venv."
        return 1
    fi

    return 0
}

# -----------------------------------------------------------------------------
# CLI WRAPPER FUNCTIONS
# -----------------------------------------------------------------------------

# mrtamaki_run: Run the mrtamaki CLI with venv management.
# Ensures venv exists, activates it, and runs mrtamaki with passed arguments.
# Usage: mrtamaki_run [args...]
mrtamaki_run() {
    # Ensure venv exists and is set up
    ensure_venv_exists || return 1

    # Run mrtamaki with all passed arguments
    # Using eval to handle the command which may contain spaces
    _evm_log "Running mrtamaki..."
    eval "${MRTAMAKI_CMD}" '"$@"'
    local exit_code=$?

    if [[ $exit_code -ne 0 ]]; then
        _evm_error "mrtamaki exited with code: $exit_code"
    fi

    return $exit_code
}

# proxy_converter_run: Run proxy_converter with venv management and cleanup prompts.
# Ensures venv exists, runs proxy_converter, then prompts for cleanup actions.
# Usage: proxy_converter_run [args...]
proxy_converter_run() {
    # Ensure venv exists and is set up
    ensure_venv_exists || return 1

    # Run proxy_converter with all passed arguments
    _evm_log "Running proxy_converter..."
    _evm_log "Executing: ${PROXY_CONVERTER_CMD} $@"
    eval "${PROXY_CONVERTER_CMD}" '"$@"'
    local exit_code=$?

    if [[ $exit_code -ne 0 ]]; then
        _evm_error "proxy_converter exited with code: $exit_code"
    else
        _evm_success "proxy_converter completed successfully."
    fi

    # Always run cleanup prompts, regardless of exit code
    print "" >&2
    _evm_log "=== Post-run Cleanup Options ==="
    print "" >&2

    _run_cleanup_prompts

    return $exit_code
}

# -----------------------------------------------------------------------------
# CLEANUP FUNCTIONS
# -----------------------------------------------------------------------------

# _run_cleanup_prompts: Run the three cleanup prompts in sequence.
# Each prompt is independent; answering "no" to one doesn't skip the others.
# Usage: _run_cleanup_prompts
_run_cleanup_prompts() {
    local venv_was_deleted=0

    # -------------------------------------------------------------------------
    # Question 1: Purge venv dependencies and cache
    # -------------------------------------------------------------------------
    if ask_yes_no "Do you want to purge the venv's installed dependencies and Python/pip cache? (y/n):"; then
        _purge_venv_deps_and_cache
    else
        _evm_log "Skipped: Purging venv dependencies and cache."
    fi
    print "" >&2

    # -------------------------------------------------------------------------
    # Question 2: Delete venv itself
    # -------------------------------------------------------------------------
    if ask_yes_no "Do you want to delete the virtual environment directory at ${VENV_DIR}? (y/n):"; then
        _delete_venv_directory
        venv_was_deleted=1
    else
        _evm_log "Skipped: Deleting virtual environment."
    fi
    print "" >&2

    # -------------------------------------------------------------------------
    # Question 3: Remove ~/.bindproxy.json
    # -------------------------------------------------------------------------
    if ask_yes_no "Do you want to remove the file $HOME/.bindproxy.json? (y/n):"; then
        _remove_bindproxy_json
    else
        _evm_log "Skipped: Removing ~/.bindproxy.json."
    fi
    print "" >&2

    _evm_success "Cleanup prompts completed."
}

# _purge_venv_deps_and_cache: Remove installed packages and clear pip cache in venv.
# Leaves the venv structure intact.
# Usage: _purge_venv_deps_and_cache
_purge_venv_deps_and_cache() {
    _evm_log "Purging venv dependencies and cache..."

    local pip_cmd="${VENV_DIR}/bin/pip"
    local python_cmd="${VENV_DIR}/bin/python"

    # Check if venv exists
    if ! is_venv_valid "${VENV_DIR}"; then
        _evm_error "Virtual environment not found or invalid. Nothing to purge."
        return 1
    fi

    # Uninstall all packages except pip, setuptools, and wheel
    _evm_log "Uninstalling installed packages..."
    local freeze_output
    freeze_output=$("$pip_cmd" freeze 2>/dev/null)

    if [[ -n "$freeze_output" ]]; then
        # Parse packages using pure zsh
        local -a packages=()
        local line pkg
        for line in ${(f)freeze_output}; do
            # Skip editable installs (lines starting with -e)
            [[ "$line" == -e* ]] && continue
            # Extract package name (before == or @)
            pkg="${line%%==*}"
            pkg="${pkg%%@*}"
            pkg="${pkg%%\[*}"
            pkg="${pkg// /}"
            # Skip empty or base packages
            [[ -z "$pkg" ]] && continue
            [[ "${pkg:l}" == "pip" || "${pkg:l}" == "setuptools" || "${pkg:l}" == "wheel" ]] && continue
            packages+=("$pkg")
        done

        if (( ${#packages[@]} > 0 )); then
            for pkg in "${packages[@]}"; do
                "$pip_cmd" uninstall -y "$pkg" --quiet 2>/dev/null
            done
            _evm_success "Uninstalled packages."
        else
            _evm_log "No packages to uninstall."
        fi
    else
        _evm_log "No packages to uninstall."
    fi

    # Clear pip cache
    _evm_log "Clearing pip cache..."
    "$pip_cmd" cache purge 2>/dev/null || true
    _evm_success "Pip cache cleared."

    # Remove __pycache__ directories within the venv's site-packages
    local site_packages="${VENV_DIR}/lib"
    if [[ -d "$site_packages" ]]; then
        _evm_log "Removing __pycache__ directories in venv..."
        # Use zsh globbing instead of find
        setopt localoptions nullglob
        local -a pycache_dirs=("$site_packages"/**/__pycache__(N/))
        for dir in "${pycache_dirs[@]}"; do
            rm -rf "$dir" 2>/dev/null
        done
        _evm_success "Removed __pycache__ directories."
    fi

    # Remove .pyc files within the venv
    if [[ -d "$site_packages" ]]; then
        _evm_log "Removing .pyc files in venv..."
        # Use zsh globbing instead of find
        setopt localoptions nullglob
        local -a pyc_files=("$site_packages"/**/*.pyc(N.))
        for f in "${pyc_files[@]}"; do
            rm -f "$f" 2>/dev/null
        done
        _evm_success "Removed .pyc files."
    fi

    _evm_success "Purge completed. Venv structure remains intact."
    return 0
}

# install_found_deps: Install dependencies for the 'found' project (including readchar).
# Assumes venv is already created or uses venv's pip directly.
# Usage: install_found_deps
install_found_deps() {
    local pip_cmd="${VENV_DIR}/bin/pip"

    if [[ ! -x "$pip_cmd" ]]; then
        _evm_error "pip not found in venv at: $pip_cmd"
        return 1
    fi

    # Install dependencies from found project's requirements file if it exists
    if [[ -f "$FOUND_REQUIREMENTS_FILE" ]]; then
        _evm_log "Installing 'found' project dependencies from: $FOUND_REQUIREMENTS_FILE"
        "$pip_cmd" install -r "$FOUND_REQUIREMENTS_FILE" --quiet
        if [[ $? -ne 0 ]]; then
            _evm_error "Failed to install 'found' dependencies from $FOUND_REQUIREMENTS_FILE"
            return 1
        fi
        _evm_success "'found' project dependencies (including readchar) installed successfully."
    else
        # Fallback: install readchar directly if no requirements file
        _evm_log "No requirements file found at $FOUND_REQUIREMENTS_FILE - installing readchar directly."
        "$pip_cmd" install readchar --quiet
        if [[ $? -ne 0 ]]; then
            _evm_error "Failed to install readchar."
            return 1
        fi
        _evm_success "readchar installed successfully."
    fi

    return 0
}

# ensure_found_deps: Ensure venv exists and 'found' project dependencies are installed.
# Usage: ensure_found_deps
ensure_found_deps() {
    ensure_venv_exists || return 1
    install_found_deps
}

# _delete_venv_directory: Safely delete the virtual environment directory.
# Performs sanity checks before deletion.
# Usage: _delete_venv_directory
_delete_venv_directory() {
    _evm_log "Preparing to delete virtual environment at: ${VENV_DIR}"

    # Safety check on the path
    if ! _safe_path_check "${VENV_DIR}"; then
        _evm_error "Refusing to delete venv due to unsafe path."
        return 1
    fi

    # Check if directory exists
    if [[ ! -d "${VENV_DIR}" ]]; then
        _evm_log "Virtual environment directory does not exist. Nothing to delete."
        return 0
    fi

    # Verify it looks like a venv (has pyvenv.cfg)
    if [[ ! -f "${VENV_DIR}/pyvenv.cfg" ]]; then
        _evm_error "Directory does not appear to be a Python venv (no pyvenv.cfg found)."
        _evm_error "Refusing to delete for safety. Please delete manually if needed."
        return 1
    fi

    # Deactivate venv if currently active
    deactivate_venv_if_active

    # Delete the venv directory
    _evm_log "Deleting: ${VENV_DIR}"
    rm -rf "${VENV_DIR}"

    if [[ $? -eq 0 ]]; then
        _evm_success "Virtual environment deleted successfully."
    else
        _evm_error "Failed to delete virtual environment."
        return 1
    fi

    return 0
}

# _remove_bindproxy_json: Safely remove the ~/.bindproxy.json file.
# Usage: _remove_bindproxy_json
_remove_bindproxy_json() {
    local target_file="$HOME/.bindproxy.json"

    _evm_log "Preparing to remove: $target_file"

    # Sanity check: ensure the path is exactly what we expect
    if [[ "$target_file" != "$HOME/.bindproxy.json" ]]; then
        _evm_error "Path mismatch. Refusing to delete."
        return 1
    fi

    # Ensure HOME is set and not empty
    if [[ -z "$HOME" ]]; then
        _evm_error "HOME environment variable is not set. Refusing to proceed."
        return 1
    fi

    # Check if file exists
    if [[ ! -f "$target_file" ]]; then
        _evm_log "File does not exist: $target_file. Nothing to remove."
        return 0
    fi

    # Remove the file
    rm -f "$target_file"

    if [[ $? -eq 0 ]]; then
        _evm_success "Removed: $target_file"
    else
        _evm_error "Failed to remove: $target_file"
        return 1
    fi

    return 0
}

# -----------------------------------------------------------------------------
# UTILITY FUNCTIONS (for manual use)
# -----------------------------------------------------------------------------

# mrtamaki_update_deps: Manually trigger dependency update in the venv.
# Useful when requirements.txt changes.
# Usage: mrtamaki_update_deps
mrtamaki_update_deps() {
    ensure_venv_exists || return 1
    install_or_update_deps
}

# mrtamaki_clean: Interactively run all cleanup prompts without running proxy_converter.
# Usage: mrtamaki_clean
mrtamaki_clean() {
    _evm_log "=== Manual Cleanup Mode ==="
    print "" >&2
    _run_cleanup_prompts
}

# mrtamaki_info: Display current configuration and venv status.
# Usage: mrtamaki_info
mrtamaki_info() {
    print "" >&2
    print "=== ensure_venv_manager Configuration ===" >&2
    print "MRTAMAKI_ROOT:      ${MRTAMAKI_ROOT}" >&2
    print "VENV_DIR:           ${VENV_DIR}" >&2
    print "REQUIREMENTS_FILE:  ${REQUIREMENTS_FILE}" >&2
    print "PYTHON_CMD:         ${PYTHON_CMD}" >&2
    print "MRTAMAKI_CMD:       ${MRTAMAKI_CMD}" >&2
    print "PROXY_CONVERTER_CMD: ${PROXY_CONVERTER_CMD}" >&2
    print "FOUND_DIR:          ${FOUND_DIR}" >&2
    print "FOUND_REQUIREMENTS_FILE: ${FOUND_REQUIREMENTS_FILE}" >&2
    print "" >&2

    print "=== Virtual Environment Status ===" >&2
    if is_venv_valid "${VENV_DIR}"; then
        print "Status: Valid venv exists" >&2
        local python_version
        python_version=$("${VENV_DIR}/bin/python" --version 2>&1)
        print "Python: $python_version" >&2
        local pkg_count
        pkg_count=$("${VENV_DIR}/bin/pip" list 2>/dev/null | tail -n +3 | wc -l | tr -d ' ')
        print "Installed packages: $pkg_count" >&2
    else
        print "Status: No valid venv found" >&2
    fi
    print "" >&2

    print "=== Files ===" >&2
    if [[ -f "${REQUIREMENTS_FILE}" ]]; then
        print "requirements.txt: Found" >&2
    else
        print "requirements.txt: Not found" >&2
    fi
    if [[ -f "$HOME/.bindproxy.json" ]]; then
        print "~/.bindproxy.json: Exists" >&2
    else
        print "~/.bindproxy.json: Not found" >&2
    fi
    print "" >&2
}

# =============================================================================
# USAGE GUIDE (for ~/.zshrc integration)
# =============================================================================
#
# HOW TO INSTALL AND USE THIS SCRIPT
# -----------------------------------
#
# 1. Save this script to a location in your home directory, for example:
#
#        mkdir -p ~/scripts
#        cp ensure_venv_manager ~/scripts/ensure_venv_manager
#
# 2. Make the script executable (optional, but good practice):
#
#        chmod +x ~/scripts/ensure_venv_manager
#
# 3. Add the following lines to your ~/.zshrc file:
#
#        # mrtamaki venv manager
#        # Optionally override configuration variables before sourcing:
#        # export MRTAMAKI_ROOT="/path/to/your/mrtamaki"
#        # export PYTHON_CMD="python3.11"
#        source ~/scripts/ensure_venv_manager
#
# 4. Reload your shell or run:
#
#        source ~/.zshrc
#
# AVAILABLE COMMANDS AFTER SOURCING
# ---------------------------------
#
#   mrtamaki_run [args...]
#       Ensures the venv exists and runs the mrtamaki CLI with the given arguments.
#       Example: mrtamaki_run --help
#                mrtamaki_run convert input.txt output.json
#
#   proxy_converter_run [args...]
#       Ensures the venv exists, runs proxy_converter with the given arguments,
#       then presents three interactive cleanup prompts:
#         1. Purge venv dependencies and cache
#         2. Delete the virtual environment directory
#         3. Remove ~/.bindproxy.json
#       Each question is independent; answering "no" to one won't skip the others.
#       Example: proxy_converter_run --input config.yaml
#
#   mrtamaki_update_deps
#       Manually updates/reinstalls dependencies from requirements.txt.
#       Useful after modifying requirements.txt.
#
#   mrtamaki_clean
#       Runs the cleanup prompts interactively without running proxy_converter.
#       Useful for manual cleanup.
#
#   mrtamaki_info
#       Displays current configuration and venv status.
#
#   ensure_found_deps
#       Ensures the venv exists and installs 'found' project dependencies
#       (including readchar) from Files/requirements.txt.
#       Example: ensure_found_deps
#
# CONFIGURATION OVERRIDES
# -----------------------
#
# You can override any configuration variable by setting it as an environment
# variable BEFORE sourcing this script. For example, in your ~/.zshrc:
#
#   export MRTAMAKI_ROOT="$HOME/projects/mrtamaki"
#   export PYTHON_CMD="python3.12"
#   export PROXY_CONVERTER_CMD="${VENV_DIR}/bin/proxy_converter"
#   source ~/scripts/ensure_venv_manager
#
# Available configuration variables:
#   - MRTAMAKI_ROOT:          Root directory of the mrtamaki project
#   - VENV_DIR:               Directory for the virtual environment
#   - REQUIREMENTS_FILE:      Path to requirements.txt
#   - PYTHON_CMD:             Python interpreter command
#   - MRTAMAKI_CMD:           Command to run mrtamaki CLI
#   - PROXY_CONVERTER_CMD:    Command to run proxy_converter
#   - FOUND_DIR:              Directory for the 'found' project
#   - FOUND_REQUIREMENTS_FILE: Path to 'found' project requirements.txt
#
# EXAMPLE ~/.zshrc CONFIGURATION
# ------------------------------
#
#   # === mrtamaki toolkit ===
#   export MRTAMAKI_ROOT="$HOME/projects/mrtamaki"
#   source ~/scripts/ensure_venv_manager
#
#   # Optional: Create shorter aliases
#   alias mrt='mrtamaki_run'
#   alias pxc='proxy_converter_run'
#   alias mrt-info='mrtamaki_info'
#   alias mrt-clean='mrtamaki_clean'
#
# =============================================================================
